{
  "manifest_version": 3,
  "name": "HermesTube",
  "short_name": "HermesTube",
  "description": "Companion to the HermesTube plugin for Hermes Agent: syncs subscriptions and runs actions you approve. Not affiliated with YouTube.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "HermesTube",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.youtube.com/*"]
}
